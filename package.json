{
  "name": "near-mvp",
  "version": "1.0.0",
  "description": "A fully collateralized, cash-settled **put-spread protection ticket** on NEAR. This is the first-stage implementation of option A in [the hackathon MVP design](../docs/04-near-hackathon-mvp.md). It is built and tested locally against the NEAR sandbox; it is **not deployed** and no wallet or funds were used.",
  "main": "index.js",
  "scripts": {
    "test": "bash scripts/test.sh",
    "e2e": "node sim/e2e.mts --url http://127.0.0.1:8790 --out evidence/e2e",
    "e2e:settle": "node sim/e2e.mts --url http://127.0.0.1:8790 --out evidence/e2e --settle",
    "e2e:suite": "node sim/suite.mts --url http://127.0.0.1:8790 --out evidence/suite",
    "video:render": "ts-node render-video.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@defuse-protocol/one-click-sdk-typescript": "0.1.26",
    "@near-wallet-selector/core": "10.1.4",
    "@near-wallet-selector/modal-ui": "10.1.4",
    "@near-wallet-selector/my-near-wallet": "10.1.4",
    "@remotion/cli": "^4.0.540",
    "near-api-js": "^4.0.4",
    "util": "0.12.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "esbuild": "0.28.2",
    "playwright-core": "^1.64.1",
    "remotion": "^4.0.539",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "base-x": "^3.0.11",
    "secp256k1": "^5.0.1"
  }
}
